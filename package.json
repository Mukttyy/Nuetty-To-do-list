{
  "name": "nuetty",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "node scripts/migrate.mjs",
    "db:setup": "npm run db:up && npm run db:migrate && npm run db:seed:demo",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "db:test:setup": "npm run db:up && NODE_ENV=test node scripts/reset-test-database.mjs && NODE_ENV=test node scripts/migrate.mjs && NODE_ENV=test tsx scripts/seed-demo.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "npm run db:test:setup && NODE_ENV=test playwright test"
  },
  "dependencies": {
    "@next/env": "^16.3.4",
    "better-auth": "^1.7.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.42.0",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
